settings set interpreter.prompt-on-quit false

gdb-remote localhost:1234

# opensbi is linked at 0x0, and loaded at 0x80000000
target modules add opensbi/build/platform/generic/firmware/fw_jump.elf
target modules load --file opensbi/build/platform/generic/firmware/fw_jump.elf --slide 0x80000000

target modules add linux/vmlinux
target modules load --file linux/vmlinux --slide 0x0

b fw_jump.elf`sbi_init
b vmlinux`start_kernel
b vmlinux`sys_off_notify

c
