settings set interpreter.prompt-on-quit false

gdb-remote localhost:1234

# During boot, EDK2 prints loading address for modules
# Loading PEIM at 0x000BFE81000 EntryPoint=0x000BFE97E5F DxeCore.efi
target modules add edk2/Build/OvmfX64/DEBUG_GCC5/X64/MdeModulePkg/Core/Dxe/DxeMain/DEBUG/DxeCore.dll
target modules load --file edk2/Build/OvmfX64/DEBUG_GCC5/X64/MdeModulePkg/Core/Dxe/DxeMain/DEBUG/DxeCore.dll --slide 0x000BFE81000

target modules add linux/vmlinux
target modules load --file linux/vmlinux --slide 0x0

b DxeCore.dll`DxeMain
b vmlinux`start_kernel
b vmlinux`sys_off_notify

c
