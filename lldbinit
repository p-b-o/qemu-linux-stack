settings set interpreter.prompt-on-quit false

gdb-remote localhost:1234

target modules add arm-trusted-firmware/build/qemu_sbsa/debug/bl1/bl1.elf
target modules load --file arm-trusted-firmware/build/qemu_sbsa/debug/bl1/bl1.elf --slide 0x0

target modules add arm-trusted-firmware/build/qemu_sbsa/debug/bl2/bl2.elf
target modules load --file arm-trusted-firmware/build/qemu_sbsa/debug/bl2/bl2.elf --slide 0x0

target modules add arm-trusted-firmware/build/qemu_sbsa/debug/bl31/bl31.elf
target modules load --file arm-trusted-firmware/build/qemu_sbsa/debug/bl31/bl31.elf --slide 0x0

# For rmm, we need to find loaded address (chosen by TF-A) + offset (build)
# Check for RMM address loaded by TF-A:
# $ ./run.sh qemu-system-aarch64 | grep 'Reserved RMM memory'
# INFO:    Reserved RMM memory [0x10000000000, 0x10042ffffff] in Device tree
# Check for offset in RMM image:
# ./build_tf_rmm.sh |& grep 'offset of the RMM core'
# INFO: The offset of the RMM core is 131072 (0x20000) bytes from start of packaged bin
target modules add tf-rmm/build/Debug/rmm.elf
target modules load --file tf-rmm/build/Debug/rmm.elf --slide 0x10000020000

# EDK2 directly prints gdb add-symbol-file commands with .text address.
# only DxeCore is added here
# lldb slide is the image base, i.e. add-symbol-file address - .text address
# (.text address is the PE header size, SizeOfHeaders).
# $ ./run.sh qemu-system-aarch64 | grep 'DxeCore.dll'
# add-symbol-file .../DxeCore.dll 0x1007F7CF000
# $ readelf -SW .../DxeCore.dll | grep .text
# [ 1] .text  PROGBITS  0000000000001000 ...
# -> slide = 0x1007F7CF000 - 0x1000 = 0x1007F7CE000
target modules add edk2/Build/SbsaQemuRme/DEBUG_GCC5/AARCH64/MdeModulePkg/Core/Dxe/DxeMain/DEBUG/DxeCore.dll
target modules load --file edk2/Build/SbsaQemuRme/DEBUG_GCC5/AARCH64/MdeModulePkg/Core/Dxe/DxeMain/DEBUG/DxeCore.dll --slide 0x1007F7CE000

target modules add linux/vmlinux
target modules load --file linux/vmlinux --slide 0x0

b bl1.elf`bl1_main
b bl2.elf`bl2_main
b bl31.elf`bl31_main
b rmm.elf`rmm_main
b DxeCore.dll`DxeMain
b vmlinux`start_kernel
b vmlinux`sys_off_notify

c
